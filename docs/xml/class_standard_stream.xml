<parameteritem>
<parameternamelist>
<parametername>numberOfBytes</parametername>
</parameternamelist>
<parameterdescription>
<para>The number of bytes in dataToWrite.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>True while the stream accepts writes, false once the stream is closed. </para>
</simplesect>
</para>
