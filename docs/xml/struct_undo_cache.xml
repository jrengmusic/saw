<parameteritem>
<parameternamelist>
<parametername>isForce</parametername>
</parameternamelist>
<parameterdescription>
<para>True to take a pending record that already exists.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Status result paired with true when the record came out of the undo folder, and false when the record was not moved. </para>
</simplesect>
</para>
